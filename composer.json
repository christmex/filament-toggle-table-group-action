{
    "name": "christmex/filament-toggle-table-group-action",
    "description": "This is my package filament-toggle-table-group-action",
    "keywords": [
        "christmex",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-toggle-table-group-action"
    ],
    "homepage": "https://github.com/christmex/filament-toggle-table-group-action",
    "support": {
        "issues": "https://github.com/christmex/filament-toggle-table-group-action/issues",
        "source": "https://github.com/christmex/filament-toggle-table-group-action"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "christmex",
            "email": "christmex@yahoo.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/tables": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Christmex\\FilamentToggleTableGroupAction\\": "src/",
            "Christmex\\FilamentToggleTableGroupAction\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Christmex\\FilamentToggleTableGroupAction\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Christmex\\FilamentToggleTableGroupAction\\FilamentToggleTableGroupActionServiceProvider"
            ],
            "aliases": {
                "FilamentToggleTableGroupAction": "Christmex\\FilamentToggleTableGroupAction\\Facades\\FilamentToggleTableGroupAction"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}